{
  "name": "@dlh/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests --exclude '**/*.db.test.ts'",
    "test:db": "vitest run --passWithNoTests '.db.test.ts' --exclude '**/*.perf.db.test.ts'",
    "test:perf": "vitest run '.perf.db.test.ts'",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@dlh/core": "workspace:*",
    "@dlh/db": "workspace:*",
    "@trpc/server": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vitest": "^5.0.5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
