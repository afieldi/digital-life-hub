{
  "name": "@dlh/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "tsx ../../scripts/gen-modules.ts",
    "dev": "tsx ../../scripts/gen-modules.ts && cross-env NODE_ENV=development tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsx ../../scripts/gen-modules.ts && tsup",
    "sessions": "tsx --env-file-if-exists=.env src/cli/sessions.ts",
    "tokens": "tsx --env-file-if-exists=.env src/cli/serviceTokens.ts",
    "migrate": "tsx ../../scripts/gen-modules.ts && tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "seed": "tsx ../../scripts/gen-modules.ts && tsx --env-file-if-exists=.env src/cli/seed.ts",
    "ai:smoke": "tsx --env-file-if-exists=.env src/cli/ai-smoke.ts",
    "docker:build": "docker build -f Dockerfile -t dlh-api ../..",
    "test": "tsx ../../scripts/gen-modules.ts && vitest run --passWithNoTests --exclude '**/*.db.test.ts'",
    "test:db": "vitest run --passWithNoTests '.db.test.ts'",
    "typecheck": "tsx ../../scripts/gen-modules.ts && tsc --noEmit -p ."
  },
  "dependencies": {
    "@dlh/api-contract": "workspace:*",
    "@dlh/db": "workspace:*",
    "@dlh/server": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@hono/trpc-server": "^0.4.2",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.14",
    "jose": "^6.2.14",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dlh/core": "workspace:*",
    "@types/node": "catalog:",
    "cross-env": "^10.1.0",
    "tsup": "^9.0.0",
    "tsx": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    "./router": "./src/router.ts",
    "./testing": "./src/testing.ts"
  }
}
