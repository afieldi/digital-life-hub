#!/bin/sh
# Fetches a granted connection's secret from the run's socket, on each use.
#   dlh-credential git <get|store|erase>   git's credential-helper protocol
#                                          (github.com only; the connection
#                                          is $DLH_GITHUB_CONNECTION)
#   dlh-credential aws <name>              credential_process JSON
# Prints a secret only where the protocol asks for it, on stdout.
set -u

SOCKET=${DLH_SOCKET:-/run/dlh/dlh.sock}

die() {
  echo "dlh-credential: $*" >&2
  exit 1
}

# fetch <type> <name>: the response body ({"secret":{...}}) on stdout.
fetch() {
  path=$(jq -rn --arg t "$1" --arg n "$2" '"/credentials/\($t|@uri)/\($n|@uri)"') ||
    die "can't encode the name"
  body=$(curl -sS --fail-with-body --max-time 30 \
    --unix-socket "$SOCKET" "http://dlh$path" 2>/dev/null)
  status=$?
  if [ "$status" -ne 0 ]; then
    reason=$(printf '%s' "$body" | jq -r '.error // empty' 2>/dev/null)
    die "${reason:-no answer from the worker} ($1 $2)"
  fi
  printf '%s' "$body"
}

git_helper() {
  op=${1:-}
  protocol=
  host=
  # Read the request to its end, even for an operation that's ignored.
  while IFS= read -r line; do
    [ -z "$line" ] && break
    case $line in
      protocol=*) protocol=${line#protocol=} ;;
      host=*) host=${line#host=} ;;
    esac
  done
  [ "$op" = get ] || exit 0
  [ "$protocol" = https ] && [ "$host" = github.com ] || exit 0
  name=${DLH_GITHUB_CONNECTION:-}
  [ -n "$name" ] || exit 0
  body=$(fetch github "$name") || exit 0
  token=$(printf '%s' "$body" | jq -er '.secret.token') || exit 0
  printf 'username=x-access-token\npassword=%s\n' "$token"
}

aws_process() {
  [ $# -eq 1 ] && [ -n "$1" ] || die "usage: dlh-credential aws <name>"
  body=$(fetch aws "$1") || exit 1
  printf '%s' "$body" | jq -ce '.secret | {
    Version: 1,
    AccessKeyId, SecretAccessKey, SessionToken, Expiration
  } | select(.AccessKeyId and .SecretAccessKey and .SessionToken)' ||
    die "no credentials for $1"
}

case ${1:-} in
  git) shift; git_helper "$@" ;;
  aws) shift; aws_process "$@" ;;
  *) die "usage: dlh-credential git <get|store|erase> | dlh-credential aws <name>" ;;
esac
