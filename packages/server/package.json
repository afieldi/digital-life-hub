  },
  "dependencies": {
    "@dlh/core": "workspace:*",
    "@dlh/db": "workspace:*",
    "@trpc/server": "^11.22.1",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "vitest": "^5.0.5"
  }
}
