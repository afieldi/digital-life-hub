# Copy to deploy/vps/.env (git-ignored) and fill in. Placeholders only.
POSTGRES_PASSWORD=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL=
# Optional
OPENROUTER_API_KEY=
# openssl rand -base64 32  (keep a copy: losing it loses stored connection secrets)
AGENT_SECRETS_KEY=
# `pnpm --filter @dlh/api tokens worker create` (see README)
AGENT_WORKER_TOKEN=
# A Vercel AI Gateway key with a monthly budget
AI_GATEWAY_API_KEY=
# A second Gateway key, with its own budget, for the API (Jev and Slack answers).
# Set AI_GATEWAY_DEFAULT_MODEL with it (a Gateway model id).
API_AI_GATEWAY_API_KEY=
AI_GATEWAY_DEFAULT_MODEL=
# Slack bot (README "The Slack bot"): the app-level, bot and user tokens
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
# `pnpm --filter @dlh/api tokens slack create` (see README)
HUB_SLACK_TOKEN=
# Uncomment once the four Slack values above are set, to run the bot
# COMPOSE_PROFILES=slack
