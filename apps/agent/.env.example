# The hub API the worker talks to.
API_URL=http://127.0.0.1:8787
# A worker token (pnpm --filter @dlh/api tokens), never a user's session.
WORKER_TOKEN=
# The Vercel AI Gateway key the containers' model calls are signed with.
GATEWAY_KEY=
# GATEWAY_URL=https://ai-gateway.vercel.sh/claude-code
# 32 random bytes, base64: openssl rand -base64 32 (must match the hub's key).
SECRETS_KEY=
# DATA_DIR=/var/lib/dlh-agent
