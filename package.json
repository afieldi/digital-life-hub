{
  "name": "digital-life-hub",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "turbo run build",
    "test": "turbo run test && vitest run --root . scripts",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . && tsx scripts/check-module-classes.ts && tsx scripts/gen-modules.ts --check",
    "test:scripts": "vitest run scripts",
    "test:db": "turbo run test:db --concurrency=1",
    "dev:down": "docker compose down",
    "db:reset": "pnpm --filter @dlh/db reset && pnpm --filter @dlh/api seed",
    "gen:modules": "tsx scripts/gen-modules.ts",
    "ai:eval-interpreter": "tsx scripts/ai-eval-interpreter.ts",
    "ai:smoke": "pnpm --filter @dlh/api ai:smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
