# First run:
#   1. Google Cloud Console -> APIs & Services -> Credentials -> Create
#      credentials -> OAuth client ID, application type "Desktop app".
#      Loopback redirects need no redirect URI registration.
#   2. Configure the OAuth consent screen. While its publishing status is
#      "Testing", add ALLOWED_EMAIL as a test user or Google will refuse it.
#   3. Copy this file to apps/api/.env and fill in the values below.
PORT=8787
# Leave empty to use the local Docker Postgres (pnpm dev starts it).
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The only Google account allowed to sign in.
ALLOWED_EMAIL=
# Optional: enables the OpenRouter AI provider (the Claude/Codex CLI providers
# need no key). Leave unset to use CLI providers only.
# OPENROUTER_API_KEY=
# OPENROUTER_DEFAULT_MODEL=
