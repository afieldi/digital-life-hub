{
  "name": "@dlh/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "test": "vitest run --passWithNoTests",
    "test:docker": "DLH_DOCKER_TESTS=1 vitest run docker.e2e",
    "test:docker:linux": "sh test/docker/in-linux.sh",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@aws-sdk/client-sts": "3.1163.0",
    "@dlh/agent-protocol": "workspace:*",
    "@dlh/api-contract": "workspace:*",
    "@dlh/core": "workspace:*",
    "@dlh/module-agent": "workspace:*",
    "@dlh/server": "workspace:*",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dlh/api": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
