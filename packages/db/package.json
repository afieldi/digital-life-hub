{
  "name": "@dlh/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/cli/migrate.ts",
    "reset": "tsx src/cli/reset.ts",
    "test": "vitest run --passWithNoTests --exclude '**/*.db.test.ts'",
    "test:db": "vitest run '.db.test.ts'",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.0.0"
  }
}
